{
  "name": "khedmah-digital-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Khedmah Digital V1 production platform foundation workspace.",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:all",
    "test:all": "node tests/run-all-tests.mjs",
    "test:root": "node scripts/run-matched-tests.mjs tests/**/*.test.mjs",
    "start:backend": "npm --workspace apps/backend run start",
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "test:workspaces": "npm run test --workspaces --if-present",
    "validate:google": "node scripts/validate-google-config.mjs",
    "validate:operations": "node scripts/validate-operations-readiness.mjs",
    "validate:operations:production": "node scripts/validate-operations-readiness.mjs --production",
    "validate:firebase": "node scripts/validate-firebase-integration.mjs",
    "validate:firebase:production": "node scripts/validate-firebase-integration.mjs --production",
    "validate:identity:production": "node scripts/validate-identity-production-readiness.mjs",
    "verify:firebase-secrets": "node scripts/audit-firebase-secret-usage.mjs",
    "build:android": "bash scripts/build-android.sh",
    "validate:deployments": "node scripts/validate-preview-staging.mjs",
    "validate:operator": "node scripts/validate-production-operator.mjs",
    "validate:database": "node scripts/validate-database-readiness.mjs",
    "validate:production-readiness": "npm run validate:database && npm run validate:google && npm run validate:firebase && npm run validate:operations"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
