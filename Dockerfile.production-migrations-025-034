FROM postgres:16-alpine

COPY backend/migrations/versions /migrations
COPY scripts/run-production-migrations-025-034.sh /usr/local/bin/run-production-migrations-025-034

RUN chmod 0555 /usr/local/bin/run-production-migrations-025-034 \
    && chmod -R a-w /migrations

USER postgres
ENTRYPOINT ["/usr/local/bin/run-production-migrations-025-034"]
