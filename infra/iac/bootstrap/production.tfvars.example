# Production new-account bootstrap inputs. Never place secret values in this file.
# Copy outside the repository or pass TF_VAR_* values from the authenticated operator.

project_id = "REPLACE_WITH_NEW_PRODUCTION_PROJECT_ID"
region     = "me-central1"

artifact_registry_repository_id = "khedmah-digital"
cloud_sql_instance_id            = "khedmah-v1-db"
cloud_sql_database_name          = "khedmah"
cloud_sql_tier                   = "db-custom-1-3840"

runtime_service_account_id  = "khedmah-v1-runtime"
deployer_service_account_id = "khedmah-v1-deployer"

github_repository    = "khedma-sy/khedmah-digital-v1"
github_workflow_path = ".github/workflows/production-operator-new-account.yml"
github_ref           = "refs/heads/main"
