FROM postgres:16-alpine

RUN apk add --no-cache python3
COPY backend/migrations/versions /migrations
COPY scripts/deployment/run-foundation-nonproduction-migrations.sh /usr/local/bin/run-foundation-nonproduction-migrations
RUN chmod 0555 /usr/local/bin/run-foundation-nonproduction-migrations \
    && chmod -R a-w /migrations
USER postgres
ENTRYPOINT ["/usr/local/bin/run-foundation-nonproduction-migrations"]
