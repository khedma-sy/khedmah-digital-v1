FROM postgres:16-alpine

RUN apk add --no-cache python3
COPY backend/migrations/versions/025_classifieds.sql /migrations/025_classifieds.sql
COPY backend/migrations/versions/036_classifieds_rolling_publication_quota.sql /migrations/036_classifieds_rolling_publication_quota.sql
COPY scripts/deployment/run-classifieds-nonproduction-migration.sh /usr/local/bin/run-classifieds-nonproduction-migration
RUN chmod 0555 /usr/local/bin/run-classifieds-nonproduction-migration /migrations/025_classifieds.sql /migrations/036_classifieds_rolling_publication_quota.sql \
    && chmod -R a-w /migrations
USER postgres
ENTRYPOINT ["/usr/local/bin/run-classifieds-nonproduction-migration"]
