FROM postgres:16-alpine

RUN apk add --no-cache python3
COPY backend/migrations/versions/029_taxi_pricing_revisions.sql /migrations/029_taxi_pricing_revisions.sql
COPY scripts/deployment/run-taxi-pricing-nonproduction-migration.sh /usr/local/bin/run-taxi-pricing-nonproduction-migration
RUN chmod 0555 /usr/local/bin/run-taxi-pricing-nonproduction-migration /migrations/029_taxi_pricing_revisions.sql \
    && chmod -R a-w /migrations
USER postgres
ENTRYPOINT ["/usr/local/bin/run-taxi-pricing-nonproduction-migration"]
