# Copy to an ignored local environment file. Never commit populated values.
# Local development database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://localhost:5432/khedmah_dev

# Google Cloud / Production operator identity.
# All production values belong to the selected NEW Google account; no legacy project IDs are canonical.
GOOGLE_CLOUD_PROJECT=
PRODUCTION_GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=me-central1
GOOGLE_APPLICATION_CREDENTIALS=
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
OPERATIONS_DEPLOYER_SERVICE_ACCOUNT=
OPERATIONS_RUNTIME_SERVICE_ACCOUNT=
OPERATIONS_ARTIFACT_REPOSITORY=khedmah-digital
OPERATIONS_BACKEND_SERVICE=backend
OPERATIONS_FRONTEND_SERVICE=frontend
OPERATIONS_APPROVED_PRODUCTION=false

# Canonical public production URL and outbound email identity.
PUBLIC_SITE_URL=https://khedmah.uk
NEXT_PUBLIC_SITE_URL=https://khedmah.uk
EMAIL_FROM=noreply@mail.khedmah.uk

# Google OAuth clients. Create separate clients for Web, Android and server-side audience validation.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_SERVER_CLIENT_ID=
GOOGLE_OAUTH_ALLOWED_AUDIENCES=

# Google Maps keys. Restrict each key to its intended surface/API before production.
GOOGLE_MAPS_BROWSER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_ALLOWED_WEB_ORIGINS=
GOOGLE_MAPS_ANDROID_PACKAGE=com.khedmah.digital
GOOGLE_MAPS_ANDROID_SHA1=

# Firebase project/server configuration.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# Browser-safe Firebase values. Inject at web build time; do not reuse server credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Android Firebase configuration is stored only as a protected CI secret.
# Base64 of the NEW Firebase Android app google-services.json; never commit the JSON itself.
FIREBASE_ANDROID_GOOGLE_SERVICES_JSON_B64=

# Operations / observability.
GOOGLE_MONITORING_ENABLED=false
GOOGLE_LOGGING_ENABLED=false
GOOGLE_ERROR_REPORTING_ENABLED=false
OPERATIONS_PRODUCT_ROLE_BINDINGS=

# Bootstrap Admin. Set to a random 32+ character string and remove/rotate after bootstrap completes.
BOOTSTRAP_ADMIN_SECRET=

# Email verification / password recovery via Resend.
RESEND_API_KEY=

# Media storage in the selected Google project.
GCS_MEDIA_BUCKET=
GCS_MEDIA_LOCATION=
TF_STATE_BUCKET=

# Global rate limiting.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60

# Android release build/signing. Keep passwords and keystore contents outside Git.
KHEDMAH_API_BASE_URL=
ANDROID_RELEASE_KEYSTORE_PATH=
ANDROID_RELEASE_KEYSTORE_PASSWORD=
ANDROID_RELEASE_KEY_ALIAS=
ANDROID_RELEASE_KEY_PASSWORD=
ANDROID_VERSION_CODE=
ANDROID_VERSION_NAME=

# Optional social-auth feature gate.
FACEBOOK_AUTH_ENABLED=false
NEXT_PUBLIC_FACEBOOK_AUTH_ENABLED=false
