# Copy to an ignored local environment file. Never commit populated values.
# Local development database (PostgreSQL)
# Format: ******host:port/database
DATABASE_URL=******localhost:5432/khedmah_dev
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=me-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_SERVER_CLIENT_ID=
GOOGLE_OAUTH_ALLOWED_AUDIENCES=
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_ALLOWED_WEB_ORIGINS=
GOOGLE_MAPS_ANDROID_PACKAGE=
GOOGLE_MAPS_ANDROID_SHA1=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=
GOOGLE_MONITORING_ENABLED=false
GOOGLE_LOGGING_ENABLED=false
GOOGLE_ERROR_REPORTING_ENABLED=false
OPERATIONS_PRODUCT_ROLE_BINDINGS=
# Browser-safe Firebase values. Inject at web build time; do not reuse server credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# WP-01: Bootstrap Admin (IDENTITY-GOV-001)
# One-time initialization token (min 32 chars). Remove after first use.
BOOTSTRAP_ADMIN_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# WP-02: Email Verification
# Provider: 'log' (dev), 'none' (test/CI), or your provider key
EMAIL_PROVIDER=log
APP_URL=http://localhost:3000
EMAIL_VERIFY_EXPIRATION_MINUTES=1440
EMAIL_VERIFY_RESEND_COOLDOWN_MINUTES=5

# WP-03: Global Rate Limiting (requests per minute)
RATE_LIMIT_REGISTER_RPM=5
RATE_LIMIT_LOGIN_RPM=10
RATE_LIMIT_FORGOT_PASSWORD_RPM=3
RATE_LIMIT_CONTACT_RPM=10
RATE_LIMIT_SEARCH_RPM=60
RATE_LIMIT_PUBLIC_API_RPM=120
